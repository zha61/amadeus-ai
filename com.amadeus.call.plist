<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.amadeus.call</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/zha61/Documents/Amadeus/dist/mac-arm64/AmadeusCall.app/Contents/MacOS/AmadeusCall</string>
    </array>

    <!-- Launch immediately when loaded, and after every login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Do not restart automatically — AmadeusCall manages its own lifetime -->
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/amadeus-scheduler.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/amadeus-scheduler.log</string>
</dict>
</plist>
